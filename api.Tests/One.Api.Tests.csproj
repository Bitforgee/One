<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>One.Api.Tests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\api\One.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="One.Api.Dados.Chamados" />
    <Using Include="One.Api.Dados.Conversas" />
    <Using Include="One.Api.Dados.Artigos" />
    <Using Include="One.Api.Dados.Documentos" />
    <Using Include="One.Api.Dados.Trechos" />
    <Using Include="One.Api.Dados.Usuarios" />
    <Using Include="One.Api.Dados.Cadastros" />
    <Using Include="One.Api.Dados.Emails" />
  </ItemGroup>

</Project>
