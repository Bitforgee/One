<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>One.Api</RootNamespace>
    <UserSecretsId>one-api</UserSecretsId>
    <WarningsAsErrors>$(WarningsAsErrors);CA1502;MSG0005</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="CodeMetricsConfig.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="One.Api.Dados.Chamados" />
    <Using Include="One.Api.Dados.Conversas" />
    <Using Include="One.Api.Dados.Artigos" />
    <Using Include="One.Api.Dados.Documentos" />
    <Using Include="One.Api.Dados.Trechos" />
    <Using Include="One.Api.Dados.Usuarios" />
    <Using Include="One.Api.Dados.Cadastros" />
    <Using Include="One.Api.Dados.Emails" />
    <Using Include="One.Api.Dados.Push" />
    <Using Include="One.Api.Dados.Fluxos" />
  </ItemGroup>
</Project>
